# Auth
# Use demo locally until Clerk is configured. Use clerk in production.
AUTH_MODE=demo
NEXT_PUBLIC_AUTH_MODE=demo
# Production safety valve. Leave empty/false in production unless you intentionally
# want the API to accept demo auth before Clerk is fully configured.
DEMO_API_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External APIs
OPENAI_API_KEY=
NEWS_API_KEY=
FIRECRAWL_API_KEY=

# Zaylo legacy local bridge (optional)
ZAYLO_SOCIALS_DIR=
ZAYLO_PDF_IMPORT_DIR=
